# 服务基础配置
NODE_ID=diary-backend-01
HTTP_PORT=8000
WS_PORT=8001

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=diary_system
MYSQL_MAX_CONNECTIONS=20

# Redis 缓存与分布式锁配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 鉴权配置
JWT_SECRET=diary_system_jwt_secret_key_2026_super_safe
JWT_EXPIRES_IN=7d

# 日志输出配置 (控制台直显)
LOG_LEVEL=INFO
