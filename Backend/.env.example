# =================================================================
# DiarySystem 后端服务环境配置模版
# 说明: 复制本文件为 .env 并根据实际环境调整配置项:
# Windows (PowerShell): Copy-Item .env.example .env
# Linux / macOS:        cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. 服务基础运行配置
# -----------------------------------------------------------------
# 节点实例唯一标识
NODE_ID=diary-backend-01
# HTTP API 网关监听端口
HTTP_PORT=8000
# WebSocket 实时连接端口
WS_PORT=8001

# -----------------------------------------------------------------
# 2. MySQL 数据库完整配置
# -----------------------------------------------------------------
# 数据库主机地址 (本地开发: localhost 或 127.0.0.1; 容器网络: mysql 或外部 IP)
MYSQL_HOST=localhost
# 数据库端口 (默认: 3306)
MYSQL_PORT=3306
# 数据库用户名 (默认: root)
MYSQL_USER=root
# 数据库访问密码 (请根据实际环境填写，开发环境常用: root 或留空)
MYSQL_PASSWORD=root
# 数据库名称 (系统初始化时会自动创建或连接该库)
MYSQL_DB=diary_system
# 数据库连接池最大连接数 (默认: 20)
MYSQL_MAX_CONNECTIONS=20
# 建立连接超时时长 (毫秒，默认: 10000 即 10 秒)
MYSQL_CONNECT_TIMEOUT=10000
# 时区配置 (默认: +08:00 北京时间)
MYSQL_TIMEZONE=+08:00
# 字符集编码 (默认: utf8mb4 支持 Emoji 表情与多国语言)
MYSQL_CHARSET=utf8mb4

# -----------------------------------------------------------------
# 3. 缓存与分布式锁配置 (可选，系统默认内置高性能内存缓存)
# -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------
# 4. JWT 身份鉴权配置
# -----------------------------------------------------------------
# JWT Token 签名密钥 (生产环境请务必更换为高强度复杂字符串)
JWT_SECRET=diary_system_jwt_secret_key_2026_super_safe
# JWT Token 有效期 (例如: 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------
# 5. 日志输出配置
# -----------------------------------------------------------------
# 控制台日志级别: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
