{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "#core": ["src/core/index.ts"],
      "@core/*": ["src/core/*"],
      "@core": ["src/core/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
