{
  "name": "@diarysystem/backend",
  "version": "1.0.0",
  "description": "DiarySystem 高性能微内核后端服务 (MySQL 适配版)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
